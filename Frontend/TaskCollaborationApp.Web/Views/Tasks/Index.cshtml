@{
    ViewData["Title"] = "Task Board";
}

<!DOCTYPE html>
<html>
<head>
    <title>Task Board - Task Collaboration</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: #fafafa;
            min-height: 100vh;
        }

        /* Header */
        .header {
            background: #ffffff;
            border-bottom: 1px solid #e6e6e6;
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .logo-text {
            font-size: 24px;
            font-weight: 700;
            color: #1a1a1a;
            letter-spacing: -0.5px;
        }

        .nav-links {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .nav-link {
            color: #757575;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 12px;
            border-radius: 4px;
            transition: all 0.2s;
        }

            .nav-link:hover {
                background: #f9f9f9;
                color: #1a1a1a;
            }

            .nav-link.active {
                background: #e3fcef;
                color: #00875a;
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 4px;
            transition: all 0.2s;
        }

            .user-info:hover {
                background: #f9f9f9;
            }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #1a8917;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 14px;
        }

        .user-name {
            font-size: 14px;
            color: #1a1a1a;
            font-weight: 500;
        }

        .btn-logout {
            padding: 8px 16px;
            background: #ffffff;
            border: 1px solid #e6e6e6;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            color: #1a1a1a;
            transition: all 0.2s;
        }

            .btn-logout:hover {
                background: #f9f9f9;
                border-color: #d6d6d6;
            }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.2s;
        }

            .modal.show {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            background: white;
            border-radius: 8px;
            width: 90%;
            max-width: 500px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            animation: slideUp 0.3s;
        }

        .modal-header {
            padding: 24px;
            border-bottom: 1px solid #e6e6e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 600;
            color: #1a1a1a;
        }

        .modal-close {
            background: none;
            border: none;
            font-size: 24px;
            color: #757575;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
            transition: all 0.2s;
        }

            .modal-close:hover {
                background: #f9f9f9;
                color: #1a1a1a;
            }

        .modal-body {
            padding: 24px;
        }

        .user-detail {
            margin-bottom: 20px;
        }

        .user-detail-label {
            font-size: 12px;
            color: #757575;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .user-detail-value {
            font-size: 16px;
            color: #1a1a1a;
            font-weight: 500;
        }

        .user-detail-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .badge-admin {
            background: #e3fcef;
            color: #00875a;
        }

        .badge-user {
            background: #deebff;
            color: #0052cc;
        }

        .modal-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
        }

        .btn-refresh {
            flex: 1;
            padding: 12px 20px;
            background: #1a8917;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .btn-refresh:hover {
                background: #156d13;
            }

            .btn-refresh:disabled {
                background: #cccccc;
                cursor: not-allowed;
            }

        /* Main Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 24px;
        }

        /* Page Header */
        .page-header {
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .page-title {
            font-size: 28px;
            font-weight: 600;
            color: #1a1a1a;
            letter-spacing: -0.5px;
        }

        .btn-primary {
            padding: 10px 20px;
            background: #1a8917;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
            transition: all 0.2s;
        }

            .btn-primary:hover {
                background: #156d13;
            }

        /* Kanban Board */
        .kanban-board {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .kanban-column {
            background: #f9f9f9;
            border-radius: 4px;
            padding: 12px;
            min-height: 500px;
        }

        .column-header {
            padding: 12px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .column-title {
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .task-count {
            background: #ffffff;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }

        /* Column Colors */
        .column-todo .column-header {
            background: #dfe1e6;
            border-radius: 4px;
        }

        .column-todo .column-title {
            color: #5e6c84;
        }

        .column-development .column-header {
            background: #deebff;
            border-radius: 4px;
        }

        .column-development .column-title {
            color: #0052cc;
        }

        .column-review .column-header {
            background: #fff0b3;
            border-radius: 4px;
        }

        .column-review .column-title {
            color: #ff991f;
        }

        .column-merge .column-header {
            background: #eae6ff;
            border-radius: 4px;
        }

        .column-merge .column-title {
            color: #6554c0;
        }

        .column-done .column-header {
            background: #e3fcef;
            border-radius: 4px;
        }

        .column-done .column-title {
            color: #00875a;
        }

        /* Task Cards */
        .task-list {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .task-card {
            background: #ffffff;
            border: 1px solid #e6e6e6;
            border-radius: 4px;
            padding: 12px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .task-card:hover {
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
                transform: translateY(-2px);
            }

        .task-title {
            font-size: 14px;
            font-weight: 500;
            color: #1a1a1a;
            margin-bottom: 8px;
            line-height: 1.4;
        }

        .task-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
        }

        .task-id {
            font-size: 12px;
            color: #b3b3b3;
            font-weight: 500;
        }

        .task-assignee {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #0052cc;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 11px;
        }

        /* Loading State */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #1a8917;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes slideUp {
            from {
                transform: translateY(20px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #b3b3b3;
        }

        .empty-state-icon {
            font-size: 48px;
            margin-bottom: 16px;
        }

        .empty-state-text {
            font-size: 14px;
        }

        /* Responsive */
        @@media (max-width: 1200px) {
            .kanban-board {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @@media (max-width: 768px) {
            .kanban-board {
                grid-template-columns: 1fr;
            }

            .header {
                flex-direction: column;
                gap: 12px;
            }

            .page-header {
                flex-direction: column;
                gap: 12px;
                align-items: stretch;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <div class="logo-text">Task</div>
            <nav class="nav-links">
                <a href="/tasks/index" class="nav-link active">Board</a>
                <a href="/tasks/my" class="nav-link">My Tasks</a>
                <a href="/tasks/all" class="nav-link" id="admin-link" style="display: none;">All Tasks</a>
            </nav>
        </div>
        <div class="header-right">
            <div class="user-info" onclick="openUserModal()">
                <div class="user-avatar" id="user-avatar"></div>
                <div class="user-name" id="user-name">Loading...</div>
            </div>
            <button class="btn-logout" onclick="logout()">Logout</button>
        </div>
    </div>

    <!-- User Info Modal -->
    <div id="userModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title">User Information</h2>
                <button class="modal-close" onclick="closeUserModal()">&times;</button>
            </div>
            <div class="modal-body">
                <div class="user-detail">
                    <div class="user-detail-label">Name</div>
                    <div class="user-detail-value" id="modal-name">-</div>
                </div>
                <div class="user-detail">
                    <div class="user-detail-label">Username</div>
                    <div class="user-detail-value" id="modal-username">-</div>
                </div>
                <div class="user-detail">
                    <div class="user-detail-label">Email</div>
                    <div class="user-detail-value" id="modal-email">-</div>
                </div>
                <div class="user-detail">
                    <div class="user-detail-label">Role</div>
                    <div>
                        <span class="user-detail-badge" id="modal-role-badge">-</span>
                    </div>
                </div>
                <div class="user-detail">
                    <div class="user-detail-label">User ID</div>
                    <div class="user-detail-value" id="modal-userid">-</div>
                </div>
                <div class="modal-actions">
                    <button class="btn-refresh" onclick="refreshToken()" id="btn-refresh">
                        🔄 Refresh Token
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Container -->
    <div class="container">
        <!-- Page Header -->
        <div class="page-header">
            <h1 class="page-title">Task Board</h1>
            <button class="btn-primary" onclick="createTask()">
                <span>+ Create Task</span>
            </button>
        </div>

        <!-- Kanban Board -->
        <div class="kanban-board" id="kanban-board">
            <!-- To-Do Column -->
            <div class="kanban-column column-todo">
                <div class="column-header">
                    <span class="column-title">To Do</span>
                    <span class="task-count" id="count-todo">0</span>
                </div>
                <div class="task-list" id="tasks-todo">
                    <div class="empty-state">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>

            <!-- Development Column -->
            <div class="kanban-column column-development">
                <div class="column-header">
                    <span class="column-title">Development</span>
                    <span class="task-count" id="count-development">0</span>
                </div>
                <div class="task-list" id="tasks-development">
                    <div class="empty-state">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>

            <!-- Review Column -->
            <div class="kanban-column column-review">
                <div class="column-header">
                    <span class="column-title">Review</span>
                    <span class="task-count" id="count-review">0</span>
                </div>
                <div class="task-list" id="tasks-review">
                    <div class="empty-state">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>

            <!-- Merge Column -->
            <div class="kanban-column column-merge">
                <div class="column-header">
                    <span class="column-title">Merge</span>
                    <span class="task-count" id="count-merge">0</span>
                </div>
                <div class="task-list" id="tasks-merge">
                    <div class="empty-state">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>

            <!-- Done Column -->
            <div class="kanban-column column-done">
                <div class="column-header">
                    <span class="column-title">Done</span>
                    <span class="task-count" id="count-done">0</span>
                </div>
                <div class="task-list" id="tasks-done">
                    <div class="empty-state">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        const API_URL = '@ViewBag.ApiBaseUrl';
        let connection;
        let currentUser;

        // Get token from ViewBag (Session)
        let JWT_TOKEN = '@ViewBag.Token';

        // Initialize
        document.addEventListener('DOMContentLoaded', async () => {
            await loadCurrentUser();
            await loadTasks();
            await initializeSignalR();
        });

        // Load current user from API
        async function loadCurrentUser() {
            if (!JWT_TOKEN || JWT_TOKEN === 'No token') {
                window.location.href = '/Login';
                return;
            }

            try {
                // Fetch user info from API
                const response = await fetch(`${API_URL}/api/auth/me`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${JWT_TOKEN}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const user = await response.json();

                    currentUser = {
                        userId: user.id.toString(),
                        name: user.name,
                        role: user.role,
                        email: user.email,
                        username: user.username
                    };

                    // Update UI
                    document.getElementById('user-name').textContent = user.name;
                    document.getElementById('user-avatar').textContent = user.name.charAt(0).toUpperCase();

                    // Show admin link if user is admin
                    if (user.role === 'Admin') {
                        document.getElementById('admin-link').style.display = 'block';
                    }
                } else if (response.status === 401) {
                    // Token expired or invalid
                    showToast('Session expired. Please login again.', 'error');
                    setTimeout(() => {
                        window.location.href = '/Login';
                    }, 2000);
                } else {
                    showToast('Failed to load user info', 'error');
                }
            } catch (error) {
                console.error('Error loading user:', error);
                showToast('Connection error: ' + error.message, 'error');
            }
        }

        // Open user modal with API data
        async function openUserModal() {
            if (!currentUser) {
                showToast('User information not loaded', 'error');
                return;
            }

            // Refresh user info from API when opening modal
            try {
                const response = await fetch(`${API_URL}/api/auth/me`, {
                    method: 'GET',
                    headers: {
                        'Authorization': `Bearer ${JWT_TOKEN}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const user = await response.json();

                    // Update modal content
                    document.getElementById('modal-name').textContent = user.name;
                    document.getElementById('modal-username').textContent = user.username;
                    document.getElementById('modal-email').textContent = user.email;
                    document.getElementById('modal-userid').textContent = user.id;

                    const roleBadge = document.getElementById('modal-role-badge');
                    roleBadge.textContent = user.role;
                    roleBadge.className = `user-detail-badge ${user.role === 'Admin' ? 'badge-admin' : 'badge-user'}`;

                    document.getElementById('userModal').classList.add('show');
                } else {
                    showToast('Failed to load user info', 'error');
                }
            } catch (error) {
                console.error('Error loading user info:', error);
                showToast('Connection error: ' + error.message, 'error');
            }
        }

        // Close user modal
        function closeUserModal() {
            document.getElementById('userModal').classList.remove('show');
        }

        // Close modal when clicking outside
        window.onclick = function (event) {
            const modal = document.getElementById('userModal');
            if (event.target === modal) {
                closeUserModal();
            }
        }

        // Refresh token
        async function refreshToken() {
            const btnRefresh = document.getElementById('btn-refresh');
            btnRefresh.disabled = true;
            btnRefresh.textContent = '🔄 Refreshing...';

            try {
                const response = await fetch(`${API_URL}/api/auth/refresh`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ token: JWT_TOKEN })
                });

                if (response.ok) {
                    const data = await response.json();

                    try {
                        // Update session via server call
                        await fetch('/Login/UpdateToken', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ token: data.token })
                        });

                        showToast('Token refreshed successfully. Reloading...', 'success');

                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } catch (error) {
                        console.error("Error while updating Token:", error);
                        showToast('Failed to update session', 'error');
                        btnRefresh.disabled = false;
                        btnRefresh.textContent = '🔄 Refresh Token';
                    }
                } else {
                    const errorData = await response.json().catch(() => ({}));
                    showToast(errorData.message || 'Failed to refresh token', 'error');
                    btnRefresh.disabled = false;
                    btnRefresh.textContent = '🔄 Refresh Token';
                }
            } catch (error) {
                console.error('Error refreshing token:', error);
                showToast('Connection error: ' + error.message, 'error');
                btnRefresh.disabled = false;
                btnRefresh.textContent = '🔄 Refresh Token';
            }
        }

        // Load tasks
        async function loadTasks() {
            try {
                const response = await fetch(`${API_URL}/api/tasks`, {
                    headers: {
                        'Authorization': `Bearer ${JWT_TOKEN}`,
                        'Content-Type': 'application/json'
                    }
                });

                if (response.ok) {
                    const result = await response.json();
                    const tasks = result.data || result;
                    renderTasks(tasks);
                } else {
                    showToast('Failed to load tasks', 'error');
                }
            } catch (error) {
                console.error('Error loading tasks:', error);
                showToast('Connection error: ' + error.message, 'error');
            }
        }

        // Render tasks on board
        function renderTasks(tasks) {
            const statuses = ['ToDo', 'Development', 'Review', 'Merge', 'Done'];

            // Task Access Authorization
            if (currentUser.role !== 'Admin') {
                tasks = tasks.filter(t => t.assignedToId === parseInt(currentUser.userId));
            }

            statuses.forEach(status => {
                const statusKey = status.toLowerCase();
                const container = document.getElementById(`tasks-${statusKey}`);
                const filteredTasks = tasks.filter(t => t.status === status);

                // Update count
                document.getElementById(`count-${statusKey}`).textContent = filteredTasks.length;

                // Clear container
                container.innerHTML = '';

                // Render tasks
                if (filteredTasks.length === 0) {
                    container.innerHTML = `
                        <div class="empty-state">
                        </div>
                    `;
                } else {
                    filteredTasks.forEach(task => {
                        const taskCard = createTaskCard(task);
                        container.appendChild(taskCard);
                    });
                }
            });
        }

        // Create task card element
        function createTaskCard(task) {
            const card = document.createElement('div');
            card.className = 'task-card';
            card.onclick = () => viewTask(task.id);

            const assigneeInitial = task.assignedToName ? task.assignedToName.charAt(0).toUpperCase() : '?';

            card.innerHTML = `
                <div class="task-title">${escapeHtml(task.title)}</div>
                <div class="task-meta">
                    <span class="task-id">TASK-${task.id}</span>
                    <div class="task-assignee" title="${escapeHtml(task.assignedToName || 'Unassigned')}">${assigneeInitial}</div>
                </div>
            `;

            return card;
        }

        // Initialize SignalR
        async function initializeSignalR() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl(`${API_URL}/taskHub`, {
                    accessTokenFactory: () => JWT_TOKEN
                })
                .withAutomaticReconnect()
                .build();

            connection.on("TaskCreated", (task) => {
                showToast(`Task '${task.title}' created successfully`, 'success');
                loadTasks();
            });

            connection.on("TaskUpdated", (task) => {
                showToast(`Task '${task.title}' status updated to: ${task.status}`, 'info');
                loadTasks();
            });

            connection.on("TaskDeleted", (taskId, title) => {
                showToast(`Task deleted: ${title}`, 'warning');
                loadTasks();
            });

            connection.on("TaskAssigned", (task) => {
                if (currentUser && task.assignedToId === parseInt(currentUser.userId)) {
                    showToast(`You have been assigned to: ${task.title}`, 'info');
                }
                loadTasks();
            });

            try {
                await connection.start();
                console.log("SignalR Connected");
            } catch (error) {
                console.error("SignalR Connection Error:", error);
                showToast('Real-time updates unavailable', 'warning');
            }
        }

        // Show toast notification
        function showToast(message, type = 'info') {
            const prefix = {
                success: '✅ ',
                info: 'ℹ️ ',
                warning: '⚠️ ',
                error: '❌ '
            }[type] || '';

            alert(prefix + message);
        }

        // View task details
        function viewTask(taskId) {
            window.location.href = `/Tasks/Details/${taskId}`;
        }

        // Create new task
        function createTask() {
            window.location.href = '/Tasks/Create';
        }

        // Logout
        function logout() {
            if (connection) {
                connection.stop();
            }
            // Clear session and redirect to login
            window.location.href = '/Login/Logout';
        }

        // Escape HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>
</html>